{
  "name": "@rfi/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Typed client for the aec-rfi-agent API, generated from the committed OpenAPI snapshot",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/schema.d.ts --default-non-nullable=false",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.5.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
