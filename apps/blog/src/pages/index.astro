---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout
  title="AEC-RFI / Field Notes"
  description="Build notes from aec-rfi-agent: a revision-aware RAG agent that drafts cited answers to construction RFIs and reports gaps instead of guessing."
>
  <main class="home">
    <p class="home-intro">
      Notes from building <a href="https://github.com/ruilinlin/aec-rfi-agent">aec-rfi-agent</a> — a
      revision-aware RAG agent that drafts cited answers to construction RFIs and reports gaps
      instead of guessing. Articles embed live replays of the real pipeline; try the
      <a href="https://aec-rfi.ruilinsun.com">interactive console</a> for the full thing.
    </p>
    <a class="home-wp" href="/whitepaper/">
      <div class="home-wp-tag">Technical report</div>
      <div class="home-wp-title">The Build, Section by Section</div>
      <p class="home-wp-desc">
        Nine numbered sections from corpus to deployment: provenance, section-aware chunking,
        hybrid retrieval, the agent graph, the frozen benchmark, and what each layer measured
        out to be worth.
      </p>
      <div class="home-wp-cta">Read the whitepaper →</div>
    </a>
    <div class="home-sec">Companion essays</div>
    {posts.length === 0 && <p class="home-empty">First articles are being drafted.</p>}
    <ul class="home-list">
      {
        posts.map((post) => (
          <li class="home-item">
            <div class="home-date">{post.data.date.toISOString().slice(0, 10)}</div>
            <a class="home-title" href={`/posts/${post.id}/`}>
              {post.data.title}
            </a>
            <p class="home-desc">{post.data.description}</p>
          </li>
        ))
      }
    </ul>
  </main>
</BaseLayout>

<style>
  .home {
    max-width: 680px;
    margin: 0 auto;
    padding: 40px 20px 0;
  }
  .home-intro {
    font-size: 19px;
    line-height: 1.65;
    border-bottom: var(--med) solid var(--ink);
    padding-bottom: 24px;
    margin: 0 0 8px;
  }
  .home-empty {
    font-family: var(--mono);
    color: var(--ink2);
    font-size: 14px;
  }
  .home-wp {
    display: block;
    border: var(--med) solid var(--ink);
    padding: 18px 20px 16px;
    margin: 24px 0 8px;
    text-decoration: none;
    color: var(--ink);
    background: var(--paper);
  }
  .home-wp:hover {
    background: var(--paper2);
  }
  .home-wp-tag {
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink2);
  }
  .home-wp-title {
    font-family: var(--cad);
    font-weight: 700;
    font-size: 30px;
    line-height: 1.05;
    text-transform: uppercase;
    margin: 6px 0 8px;
  }
  .home-wp-desc {
    margin: 0 0 10px;
    color: var(--ink2);
    font-size: 16px;
    line-height: 1.6;
  }
  .home-wp-cta {
    font-family: var(--cad);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .home-sec {
    font-family: var(--cad);
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink2);
    margin-top: 22px;
    border-bottom: var(--hr) solid var(--hair);
    padding-bottom: 6px;
  }
  .home-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .home-item {
    padding: 26px 0;
    border-bottom: var(--hr) solid var(--hair);
  }
  .home-date {
    font-family: var(--mono);
    font-size: 12.5px;
    letter-spacing: 0.08em;
    color: var(--ink2);
  }
  .home-title {
    display: inline-block;
    font-family: var(--cad);
    font-weight: 700;
    font-size: 27px;
    line-height: 1.08;
    text-transform: uppercase;
    text-decoration: none;
    margin: 4px 0 6px;
  }
  .home-title:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .home-desc {
    margin: 0;
    color: var(--ink2);
    font-size: 16.5px;
    line-height: 1.6;
  }
</style>
