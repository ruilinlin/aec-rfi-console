---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout
  title="AEC-RFI / Field Notes"
  description="Build notes from aec-rfi-agent: a revision-aware RAG agent that drafts cited answers to construction RFIs and reports gaps instead of guessing."
>
  <main class="home">
    <p class="home-intro">
      Notes from building <a href="https://github.com/ruilinlin/aec-rfi-agent">aec-rfi-agent</a> — a
      revision-aware RAG agent that drafts cited answers to construction RFIs and reports gaps
      instead of guessing. Articles embed live replays of the real pipeline; try the
      <a href="https://aec-rfi.ruilinsun.com">interactive console</a> for the full thing.
    </p>
    {posts.length === 0 && <p class="home-empty">First articles are being drafted.</p>}
    <ul class="home-list">
      {
        posts.map((post) => (
          <li class="home-item">
            <div class="home-date">{post.data.date.toISOString().slice(0, 10)}</div>
            <a class="home-title" href={`/posts/${post.id}/`}>
              {post.data.title}
            </a>
            <p class="home-desc">{post.data.description}</p>
          </li>
        ))
      }
    </ul>
  </main>
</BaseLayout>

<style>
  .home {
    max-width: 680px;
    margin: 0 auto;
    padding: 40px 20px 0;
  }
  .home-intro {
    font-size: 19px;
    line-height: 1.65;
    border-bottom: var(--med) solid var(--ink);
    padding-bottom: 24px;
    margin: 0 0 8px;
  }
  .home-empty {
    font-family: var(--mono);
    color: var(--ink2);
    font-size: 14px;
  }
  .home-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .home-item {
    padding: 26px 0;
    border-bottom: var(--hr) solid var(--hair);
  }
  .home-date {
    font-family: var(--mono);
    font-size: 12.5px;
    letter-spacing: 0.08em;
    color: var(--ink2);
  }
  .home-title {
    display: inline-block;
    font-family: var(--cad);
    font-weight: 700;
    font-size: 27px;
    line-height: 1.08;
    text-transform: uppercase;
    text-decoration: none;
    margin: 4px 0 6px;
  }
  .home-title:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .home-desc {
    margin: 0;
    color: var(--ink2);
    font-size: 16.5px;
    line-height: 1.6;
  }
</style>
