---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  date: Date;
  tags?: string[];
  minutes: number;
}
const { title, description, date, tags = [], minutes } = Astro.props;
const dateLabel = date.toISOString().slice(0, 10);
---

<BaseLayout title={title} description={description}>
  <article class="post">
    <header class="post-head">
      <div class="post-meta">
        <time datetime={dateLabel}>{dateLabel}</time>
        <span>·</span>
        <span>{minutes} min read</span>
        {tags.map((tag) => <span class="post-tag">{tag}</span>)}
      </div>
      <h1 class="post-title">{title}</h1>
      <p class="post-desc">{description}</p>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style is:global>
  .post {
    max-width: 680px;
    margin: 0 auto;
    padding: 36px 20px 0;
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    font-family: var(--mono);
    font-size: 12.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink2);
  }
  .post-tag {
    border: var(--hr) solid var(--hair);
    padding: 0 7px;
  }
  .post-title {
    font-family: var(--cad);
    font-weight: 700;
    font-size: clamp(32px, 6vw, 44px);
    line-height: 1.02;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    margin: 10px 0 8px;
  }
  .post-desc {
    font-size: 20px;
    line-height: 1.5;
    color: var(--ink2);
    margin: 0 0 18px;
  }
  .post-head {
    border-bottom: var(--med) solid var(--ink);
    margin-bottom: 28px;
  }
  .prose h2 {
    font-family: var(--cad);
    font-weight: 700;
    font-size: 26px;
    line-height: 1.1;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    margin: 44px 0 12px;
  }
  .prose h3 {
    font-family: var(--cad);
    font-weight: 600;
    font-size: 19px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 32px 0 8px;
  }
  .prose p {
    margin: 0 0 20px;
  }
  .prose ul,
  .prose ol {
    padding-left: 24px;
    margin: 0 0 20px;
  }
  .prose li {
    margin-bottom: 8px;
  }
  .prose blockquote {
    border-left: 3px solid var(--ink);
    margin: 0 0 20px;
    padding: 2px 0 2px 18px;
    color: var(--ink2);
  }
  .prose hr {
    border: 0;
    border-top: var(--hr) solid var(--hair);
    margin: 36px 0;
  }
  .prose img {
    max-width: 100%;
  }
  .prose .table-scroll {
    overflow-x: auto;
    margin: 0 0 20px;
  }
  .prose table {
    border-collapse: collapse;
    font-family: var(--mono);
    font-size: 13.5px;
    line-height: 1.45;
  }
  .prose th,
  .prose td {
    border: var(--hr) solid var(--hair);
    padding: 6px 10px;
    text-align: left;
    white-space: nowrap;
  }
  .prose th {
    font-family: var(--cad);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: var(--paper2);
  }
</style>
