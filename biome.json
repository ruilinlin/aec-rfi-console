{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "organizeImports": {
    "enabled": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "files": {
    "ignore": [
      "dist",
      "node_modules",
      ".astro",
      "pnpm-lock.yaml",
      "packages/api-client/openapi.json",
      "packages/api-client/src/schema.d.ts",
      "apps/console/src/scenarios/*.json",
      "apps/blog/src/data/*.json"
    ]
  }
}
